rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email == 'jumi@teamain.org' &&
        request.auth.token.email_verified == true;
    }

    // Legacy simulator operator is scoped to the sandbox, never customer hotels.
    function isSandboxAdmin(hotelId) {
      return hotelId == 'test-hotel-001' && isVerifiedAdminEmail();
    }

    function isHotelOwner(hotelId) {
      return isSignedIn() && request.auth.uid == hotelId && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Existing hotel IDs remain stable. Memberships are provisioned only by a trusted backend.
    function hasHotelRole(hotelId, roles) {
      return isSignedIn() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/hotels/$(hotelId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/members/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/hotels/$(hotelId)/members/$(request.auth.uid)).data.role in roles;
    }

    function isHotelStaff(hotelId) {
      return isHotelOwner(hotelId) || hasHotelRole(hotelId, ['admin', 'manager', 'associate']);
    }

    function canConfigureHotel(hotelId) {
      return isHotelOwner(hotelId) || hasHotelRole(hotelId, ['admin', 'manager']);
    }

    function isValidSlas(slas) {
      return slas is map &&
        slas.keys().hasAll(['housekeeping', 'maintenance', 'front_desk']) &&
        slas.keys().hasOnly(['housekeeping', 'maintenance', 'front_desk']) &&
        slas.housekeeping is int && slas.housekeeping >= 0 && slas.housekeeping <= 1440 &&
        slas.maintenance is int && slas.maintenance >= 0 && slas.maintenance <= 1440 &&
        slas.front_desk is int && slas.front_desk >= 0 && slas.front_desk <= 1440;
    }

    function isValidHotel(data, hotelId) {
      return data.keys().hasAll(['name', 'persona', 'faqs', 'slas']) &&
        data.keys().hasOnly(['id', 'name', 'persona', 'faqs', 'slas', 'locations', 'emergencyPhone']) &&
        (!('id' in data) || (isValidId(data.id) && data.id == hotelId)) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.persona is string && data.persona.size() <= 4000 &&
        data.faqs is list && data.faqs.size() <= 100 &&
        (data.faqs.size() == 0 || data.faqs[0] is map) &&
        (!('locations' in data) || (data.locations is list && data.locations.size() <= 500 && (data.locations.size() == 0 || data.locations[0] is map))) &&
        (!('emergencyPhone' in data) || (data.emergencyPhone is string && data.emergencyPhone.size() <= 50)) &&
        isValidSlas(data.slas);
    }

    // Absolute guest access window; staff activity cannot extend it.
    function guestSessionOpen(data) {
      return data.guestUid == request.auth.uid &&
        'guestAccessStartedAt' in data && data.guestAccessStartedAt is timestamp &&
        !('guestEndedAt' in data) &&
        request.time < data.guestAccessStartedAt + duration.value(24, 'h');
    }
    function guestCanAccessSession(hotelId, sessionId) {
      return guestSessionOpen(get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(sessionId)).data);
    }

    function isValidSession(data) {
      return data.keys().hasAll(['guestUid', 'lastUpdatedAt', 'previewText', 'isUnread', 'status']) &&
        data.keys().hasOnly([
          'guestUid',
          'guestAccessStartedAt',
          'guestEndedAt',
          'roomMoveAt',
          'roomNumber',
          'locationId',
          'locationLabel',
          'locationType',
          'lastUpdatedAt',
          'previewText',
          'previewStaffText',
          'isUnread',
          'status',
          'guestLanguage',
          'assignedStaffUid',
          'assignedStaffEmail',
          'escalationReason',
          'escalationSeverity'
        ]) &&
        isValidId(data.guestUid) &&
        data.lastUpdatedAt is timestamp &&
        (!('guestAccessStartedAt' in data) || data.guestAccessStartedAt is timestamp) &&
        (!('guestEndedAt' in data) || data.guestEndedAt is timestamp) &&
        (!('roomMoveAt' in data) || data.roomMoveAt is timestamp) &&
        data.previewText is string && data.previewText.size() <= 5000 &&
        (!('previewStaffText' in data) || (data.previewStaffText is string && data.previewStaffText.size() <= 5000)) &&
        data.isUnread is bool &&
        data.status in ['active', 'awaiting_human', 'staff_controlled', 'escalated', 'completed'] &&
        (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() <= 50)) &&
        (!('locationId' in data) || (data.locationId is string && data.locationId.size() <= 128)) &&
        (!('locationLabel' in data) || (data.locationLabel is string && data.locationLabel.size() <= 100)) &&
        (!('locationType' in data) || (data.locationType is string && data.locationType.size() <= 50)) &&
        (!('guestLanguage' in data) || (data.guestLanguage is string && data.guestLanguage.size() <= 20)) &&
        (!('assignedStaffUid' in data) || (data.assignedStaffUid is string && data.assignedStaffUid.size() <= 128)) &&
        (!('assignedStaffEmail' in data) || (data.assignedStaffEmail is string && data.assignedStaffEmail.size() <= 200)) &&
        (!('escalationReason' in data) || (data.escalationReason is string && data.escalationReason.size() <= 500)) &&
        (!('escalationSeverity' in data) || data.escalationSeverity in ['high', 'critical']);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['sender', 'text', 'timestamp']) &&
        data.keys().hasOnly([
          'sender',
          'text',
          'staffText',
          'guestText',
          'originalLanguage',
          'translatedToLanguage',
          'timestamp',
          'guestUid',
          'staffUid'
        ]) &&
        data.sender in ['guest', 'ai', 'staff', 'system'] &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 5000 &&
        (!('staffText' in data) || (data.staffText is string && data.staffText.size() <= 5000)) &&
        (!('guestText' in data) || (data.guestText is string && data.guestText.size() <= 5000)) &&
        (!('originalLanguage' in data) || (data.originalLanguage is string && data.originalLanguage.size() <= 20)) &&
        (!('translatedToLanguage' in data) || (data.translatedToLanguage is string && data.translatedToLanguage.size() <= 20)) &&
        data.timestamp is timestamp &&
        (!('guestUid' in data) || isValidId(data.guestUid)) &&
        (!('staffUid' in data) || isValidId(data.staffUid));
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['sessionId', 'item', 'category', 'roomNumber', 'status', 'createdAt', 'lastUpdated']) &&
        data.keys().hasOnly([
          'referenceCode',
          'sessionId',
          'item',
          'quantity',
          'category',
          'department',
          'roomNumber',
          'status',
          'createdAt',
          'lastUpdated',
          'acknowledgedAt',
          'completedAt',
          'description',
          'originalMessage',
          'priority',
          'source',
          'guestUid'
        ]) &&
        isValidId(data.sessionId) &&
        (!('referenceCode' in data) || (data.referenceCode is string && data.referenceCode.size() >= 1 && data.referenceCode.size() <= 30)) &&
        data.item is string && data.item.size() >= 1 && data.item.size() <= 200 &&
        (!('quantity' in data) || (data.quantity is int && data.quantity >= 1 && data.quantity <= 50)) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        (!('department' in data) || (data.department is string && data.department.size() >= 1 && data.department.size() <= 100)) &&
        data.roomNumber is string && data.roomNumber.size() <= 50 &&
        data.status in ['pending', 'acknowledged', 'in_progress', 'completed', 'escalated', 'reopened', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.lastUpdated is timestamp &&
        (!('acknowledgedAt' in data) || data.acknowledgedAt is timestamp) &&
        (!('completedAt' in data) || data.completedAt is timestamp) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('originalMessage' in data) || (data.originalMessage is string && data.originalMessage.size() <= 1000)) &&
        (!('priority' in data) || data.priority in ['normal', 'high', 'urgent']) &&
        (!('source' in data) || data.source in ['ai', 'structured', 'staff']) &&
        (!('guestUid' in data) || isValidId(data.guestUid));
    }

    match /hotels/{hotelId} {
      allow get: if isSignedIn() && isValidId(hotelId);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(hotelId) &&
        isValidHotel(incoming(), hotelId) &&
        (isHotelOwner(hotelId) || isSandboxAdmin(hotelId));
      allow update: if isSignedIn() &&
        isValidId(hotelId) &&
        isValidHotel(incoming(), hotelId) &&
        (canConfigureHotel(hotelId) || isSandboxAdmin(hotelId)) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'persona', 'faqs', 'slas', 'locations', 'emergencyPhone']) &&
        (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isSignedIn() &&
          (request.auth.uid == memberUid || isHotelOwner(hotelId) || hasHotelRole(hotelId, ['admin']));
        allow list: if isHotelOwner(hotelId) || hasHotelRole(hotelId, ['admin']);
        // Clients cannot grant themselves membership or elevate privileges.
        allow create, update, delete: if false;
      }

      match /sessions/{sessionId} {
        allow get: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(sessionId) &&
          (guestSessionOpen(existing()) || isHotelStaff(hotelId) || isSandboxAdmin(hotelId));
        allow list: if isSignedIn() &&
          (guestSessionOpen(existing()) || isHotelStaff(hotelId) || isSandboxAdmin(hotelId));
        allow create: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(sessionId) &&
          isValidSession(incoming()) &&
          incoming().guestUid == request.auth.uid &&
          incoming().status == 'active' &&
          incoming().guestAccessStartedAt == request.time && !('guestEndedAt' in incoming()) && !('roomMoveAt' in incoming()) &&
          incoming().lastUpdatedAt == request.time &&
          exists(/databases/$(database)/documents/hotels/$(hotelId));
        allow update: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(sessionId) &&
          isValidSession(incoming()) &&
          incoming().guestUid == existing().guestUid &&
          (!('roomMoveAt' in existing()) || !incoming().diff(existing()).affectedKeys().hasAny(['roomNumber','locationId','locationLabel','locationType'])) &&
          incoming().lastUpdatedAt == request.time &&
          (
            (
              guestSessionOpen(existing()) &&
              (
                (('guestEndedAt' in incoming()) && incoming().guestEndedAt == request.time && incoming().diff(existing()).affectedKeys().hasOnly(['guestEndedAt','lastUpdatedAt'])) ||
                (
                  existing().status != 'completed' &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'lastUpdatedAt',
                    'previewText',
                    'previewStaffText',
                    'isUnread',
                    'roomNumber',
                    'locationId',
                    'locationLabel',
                    'locationType',
                    'guestLanguage'
                  ])
                ) ||
                (
                  existing().status != 'completed' &&
                  existing().status != 'staff_controlled' &&
                  incoming().status in ['awaiting_human', 'escalated'] &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'lastUpdatedAt',
                    'previewText',
                    'previewStaffText',
                    'isUnread',
                    'roomNumber',
                    'locationId',
                    'locationLabel',
                    'locationType',
                    'guestLanguage',
                    'status',
                    'escalationReason',
                    'escalationSeverity'
                  ])
                ) ||
                (
                  existing().status == 'completed' &&
                  incoming().status == 'active' &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'lastUpdatedAt',
                    'previewText',
                    'previewStaffText',
                    'isUnread',
                    'status',
                    'roomNumber',
                    'locationId',
                    'locationLabel',
                    'locationType',
                    'guestLanguage'
                  ])
                )
              )
            ) ||
            (
              (isHotelStaff(hotelId) || isSandboxAdmin(hotelId)) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'lastUpdatedAt',
                'previewText',
                'previewStaffText',
                'isUnread',
                'status',
                'roomNumber',
                'locationId',
                'locationLabel',
                'locationType',
                'guestLanguage',
                'assignedStaffUid',
                'assignedStaffEmail',
                'escalationReason',
                'escalationSeverity'
              ])
            )
          );
        allow delete: if false;

        match /messages/{messageId} {
          allow get: if isSignedIn() &&
            isValidId(hotelId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            (
              isHotelStaff(hotelId) ||
              isSandboxAdmin(hotelId) ||
              guestCanAccessSession(hotelId, sessionId)
            );
          allow list: if isSignedIn() &&
            (
              isHotelStaff(hotelId) ||
              isSandboxAdmin(hotelId) ||
              (existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, sessionId))
            );
          allow create: if isSignedIn() &&
            isValidId(hotelId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            isValidMessage(incoming()) &&
            incoming().timestamp == request.time &&
            exists(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(sessionId)) &&
            (
              (
                incoming().sender in ['guest', 'ai', 'system'] &&
                'guestUid' in incoming() &&
                incoming().guestUid == request.auth.uid &&
                guestCanAccessSession(hotelId, sessionId)
              ) ||
              (
                incoming().sender in ['staff', 'system'] &&
                (isHotelStaff(hotelId) || isSandboxAdmin(hotelId)) &&
                (
                  !('guestUid' in incoming()) ||
                  incoming().guestUid == get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(sessionId)).data.guestUid
                ) &&
                (!('staffUid' in incoming()) || incoming().staffUid == request.auth.uid)
              )
            );
          allow update: if isSignedIn() &&
            isValidId(hotelId) &&
            isValidId(sessionId) &&
            isValidId(messageId) &&
            isValidMessage(incoming()) &&
            !('staffText' in existing()) &&
            incoming().sender == existing().sender &&
            incoming().text == existing().text &&
            incoming().timestamp == existing().timestamp &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'staffText',
              'originalLanguage',
              'translatedToLanguage'
            ]) &&
            (
              isHotelStaff(hotelId) ||
              isSandboxAdmin(hotelId) ||
              guestCanAccessSession(hotelId, sessionId)
            );
          allow delete: if false;
        }
      }

      match /requests/{requestId} {
        allow get: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(requestId) &&
          (isHotelStaff(hotelId) || isSandboxAdmin(hotelId) || (existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, existing().sessionId)));
        allow list: if isSignedIn() &&
          (isHotelStaff(hotelId) || isSandboxAdmin(hotelId) || (existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, existing().sessionId)));
        allow create: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(requestId) &&
          isValidRequest(incoming()) &&
          incoming().status in ['pending', 'escalated'] &&
          incoming().createdAt == request.time &&
          incoming().lastUpdated == request.time &&
          exists(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(incoming().sessionId)) &&
          (
            isHotelStaff(hotelId) ||
            isSandboxAdmin(hotelId) ||
            (
              (!('guestUid' in incoming()) || incoming().guestUid == request.auth.uid) &&
              guestCanAccessSession(hotelId, incoming().sessionId) &&
              (!('roomMoveAt' in get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(incoming().sessionId)).data) || incoming().roomNumber == get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(incoming().sessionId)).data.roomNumber)
            )
          );
        allow update: if isSignedIn() &&
          isValidId(hotelId) &&
          isValidId(requestId) &&
          isValidRequest(incoming()) &&
          incoming().sessionId == existing().sessionId &&
          incoming().createdAt == existing().createdAt &&
          incoming().lastUpdated == request.time &&
          (
            (
              (
                (existing().status != 'completed' && isHotelStaff(hotelId)) ||
                isSandboxAdmin(hotelId)
              ) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status',
                'lastUpdated',
                'department',
                'priority',
                'acknowledgedAt',
                'completedAt',
                'roomNumber'
              ])
            ) ||
            (
              existing().status in ['pending', 'acknowledged', 'in_progress', 'escalated'] &&
              existing().roomNumber in ['Pending room #', 'Location needed', ''] &&
              existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, existing().sessionId) &&
              incoming().guestUid == existing().guestUid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['roomNumber', 'lastUpdated'])
            ) ||
            (
              existing().status == 'pending' &&
              existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, existing().sessionId) &&
              incoming().guestUid == existing().guestUid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'description', 'lastUpdated'])
            ) ||
            (
              existing().status == 'completed' &&
              (!('roomMoveAt' in get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(existing().sessionId)).data) || existing().roomNumber == get(/databases/$(database)/documents/hotels/$(hotelId)/sessions/$(existing().sessionId)).data.roomNumber) &&
              incoming().status == 'reopened' &&
              existing().guestUid == request.auth.uid && guestCanAccessSession(hotelId, existing().sessionId) &&
              incoming().guestUid == existing().guestUid &&
              incoming().diff(existing()).affectedKeys().hasOnly(['status', 'priority', 'lastUpdated'])
            )
          );
        allow delete: if false;
      }
    }
  }
}
